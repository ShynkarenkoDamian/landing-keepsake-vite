.middle-block-outer
    .middle-block-inner
        h2.section-title
            //- Add a section heading here.
        .cards-wrapper
            ul.list-cards
                each card, id in cards
                    li(class="card card-" + (id + 1))
                        img(src=card.image alt=card.title)
                        .card-text-part
                            h3= card.title
                            p= card.description
