section#journal.journal(aria-labelledby="journal-title")
    .container.journal__container
        h2#journal-title.journal__title From the journal
        p.journal__intro Notes on process, case studies and things that inspire us.
        .journal__grid
            each entry in journalEntries
                article.journal-card
                    a.journal-card__thumb(href="#contact" aria-label=`Read: ${entry.title}`)
                        +picture(`journal-${entry.thumbnail}`, "", 400, 400, {
                            sizes: "(min-width: 768px) 150px, 96px",
                            className: "journal-card__media",
                            imageClass: "journal-card__image",
                        })
                    .journal-card__copy
                        p.journal-card__meta
                            time(datetime=entry.dateTime)= entry.date
                            span= entry.category
                        h3.journal-card__title
                            a(href="#contact")= entry.title
                        p.journal-card__excerpt= entry.excerpt
                        a.journal-card__read-more(href="#contact")
                            | Read more
                            span(aria-hidden="true") ›
