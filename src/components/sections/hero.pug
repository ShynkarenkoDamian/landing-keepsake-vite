section.hero(aria-labelledby="hero-title")
    .container.hero__content
        h1#hero-title.hero__title We're #{ brandName }, a digital & branding agency
        p.hero__copy Specializing in web design, poster, motion video, based in London. We love to turn ideas into beautiful things.
        .hero__actions
            +btn("See our works", "#works", "primary")
            +btn("Get in touch", "#contact", "outline")
