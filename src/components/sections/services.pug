section#about.services(aria-labelledby="services-title")
    .container.services__container
        h2#services-title.services__title What do we do
        p.services__intro We are a small team of designers and makers who help brands look their best online and offline.
        .services__grid
            each service in services
                article.service-card
                    span.service-card__icon(aria-hidden="true")
                        +icon(service.icon, "icon service-card__symbol")
                    h3.service-card__title= service.title
                    p.service-card__description= service.description
