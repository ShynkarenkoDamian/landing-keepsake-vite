mixin work-card(work, href = "#contact")
    article.work-card(data-category=work.category)
        +picture(`work-${work.art}`, `${work.title} — ${work.categoryLabel} project`, 800, 632, {
            sizes: "(min-width: 1280px) 360px, (min-width: 768px) calc(50vw - 60px), calc(100vw - 40px)",
            className: "work-card__media",
            imageClass: "work-card__image",
        })
        a.work-card__overlay(href=work.href || href aria-label=`View ${work.title}, ${work.categoryLabel}`)
            +icon("plus", "work-card__plus")
            h3.work-card__name= work.title
            span.work-card__rule(aria-hidden="true")
            if work.categoryLabel
                span.work-card__category= work.categoryLabel
