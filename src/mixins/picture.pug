mixin picture(name, alt, width, height, options = {})
    - const widths = options.widths || [400, 800];
    - const sizes = options.sizes || "100vw";
    - const fallback = options.fallback || "jpg";
    - const loading = options.loading || "lazy";
    - const maxWidth = widths[widths.length - 1];
    - const srcset = (ext) => widths.map((w) => `/src/assets/images/${name}-${w}.${ext} ${w}w`).join(", ");
    picture(class=options.className)
        source(type="image/avif" srcset=srcset("avif") sizes=sizes)
        source(type="image/webp" srcset=srcset("webp") sizes=sizes)
        img(
            class=options.imageClass
            src=`/src/assets/images/${name}-${maxWidth}.${fallback}`
            alt=alt
            width=width
            height=height
            decoding="async"
            loading=loading
            fetchpriority=options.fetchPriority ? "high" : false
        )
